# Server variables only. Never prefix these with VITE_.
# No provider or deployment has been configured by this repository.
RESEND_API_KEY=
ROTY_MAIL_FROM=
ROTY_ALLOWED_ORIGINS=https://www.les-terrasses-du-roty.fr
ROTY_REDIS_REST_URL=
ROTY_REDIS_REST_TOKEN=
ROTY_FORM_HASH_SECRET=
ROTY_FORM_NAMESPACE=roty-production

# Non-local preview hosts fail closed unless password protection is configured.
ROTY_PREVIEW_MODE=1
ROTY_PREVIEW_USER=roty
ROTY_PREVIEW_PASSWORD=
# Use node-server for a local production build. Leave unset inside Lovable.
ROTY_BUILD_TARGET=

# GA4 stays disabled until the dedicated Google property has been configured.
# Public measurement ID (G-...), never an API secret. Only sent to the canonical HTTPS host.
ROTY_GA_ENABLED=0
ROTY_GA_MEASUREMENT_ID=
# Optional public verification token from Search Console, embedded in the HTML at build time.
VITE_GOOGLE_SITE_VERIFICATION=
